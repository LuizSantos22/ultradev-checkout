<?php
$_order = Mage::getSingleton('checkout/session')->getLastRealOrder();
if (!$_order || !$_order->getId()) {
    $this->_redirect('ultra-checkout');
    return;
}

$_payment      = $_order->getPayment();
$_method       = $_payment->getMethodInstance()->getCode();
$_methodTitle  = $_payment->getMethodInstance()->getTitle();
$_incrementId  = $_order->getIncrementId();
$_customerName = $_order->getCustomerFirstname();
$_status       = $_order->getStatus();
$_methodLower  = strtolower($_method);

switch ($_status) {
    case 'processing':
        $statusLabel  = 'Pagamento confirmado';
        $statusIcon   = 'bi-check-circle-fill';
        $statusColor  = '#28a745';
        $statusBg     = '#e8f5e9';
        $statusBorder = '#a5d6a7';
        $statusDesc   = 'Seu pagamento foi aprovado. Estamos preparando seu pedido.';
        break;
    case 'pending':
    case 'pending_payment':
        $statusLabel  = 'Aguardando pagamento';
        $statusIcon   = 'bi-clock-history';
        $statusColor  = '#e08a1e';
        $statusBg     = '#fdf1e2';
        $statusBorder = '#f3caa0';
        $statusDesc   = 'Seu pedido foi recebido. Assim que o pagamento for confirmado enviaremos um e-mail.';
        break;
    case 'payment_review':
        $statusLabel  = 'Pagamento em análise';
        $statusIcon   = 'bi-hourglass-split';
        $statusColor  = '#2c85c8';
        $statusBg     = '#eaf4fb';
        $statusBorder = '#a9d3ee';
        $statusDesc   = 'Seu pagamento está sendo analisado. Em breve você receberá uma atualização.';
        break;
    default:
        $statusLabel  = 'Em processamento';
        $statusIcon   = 'bi-clock-history';
        $statusColor  = '#e08a1e';
        $statusBg     = '#fdf1e2';
        $statusBorder = '#f3caa0';
        $statusDesc   = 'Seu pedido está sendo processado. Você receberá atualizações por e-mail.';
        break;
}

if (strpos($_methodLower, 'boleto') !== false || strpos($_methodLower, 'paghiper') !== false) {
    $_payIcon = 'bi-upc-scan';
} elseif (strpos($_methodLower, 'pix') !== false) {
    $_payIcon = 'bi-lightning-charge-fill';
} elseif (strpos($_methodLower, 'transfer') !== false || strpos($_methodLower, 'banktransfer') !== false) {
    $_payIcon = 'bi-bank';
} elseif (strpos($_methodLower, 'checkmo') !== false) {
    $_payIcon = 'bi-cash';
} elseif (strpos($_methodLower, 'paypal') !== false) {
    $_payIcon = 'bi-paypal';
} else {
    $_payIcon = 'bi-credit-card-2-back-fill';
}

$_grandTotal   = Mage::helper('core')->currency($_order->getGrandTotal(), true, false);
$_subtotal     = Mage::helper('core')->currency($_order->getSubtotal(), true, false);
$_shippingAmt  = Mage::helper('core')->currency($_order->getShippingAmount(), true, false);
$_discountAmt  = $_order->getDiscountAmount();
$_shippingAddr = $_order->getShippingAddress();
$_shippingDesc = $_order->getShippingDescription();

$_canViewOrder = Mage::getSingleton('customer/session')->isLoggedIn();
$_viewOrderUrl = Mage::getUrl('sales/order/view', ['order_id' => $_order->getId()]);

// Coluna 1 — Pagamento
$_paymentValue = $_methodTitle;

// Coluna 2 — Frete / Entrega
if ($_shippingAddr && $_shippingDesc) {
    $_shippingParts = explode('-', $_shippingDesc, 2);
    $_freteLabel = 'Frete';
    $_freteValue = trim($_shippingParts[0]);
    $_freteSub   = !empty($_shippingParts[1]) ? trim($_shippingParts[1]) : '';
} else {
    $_freteLabel = 'Entrega';
    $_freteValue = 'Produto digital / Retirada';
    $_freteSub   = 'Sem envio físico';
}

// Coluna 3 — Endereço de entrega / cobrança
if ($_shippingAddr && $_shippingDesc) {
    $_addrLabel = 'Endereço de entrega';
    $_addrName  = $_shippingAddr->getName();
    $_addrLine  = $_shippingAddr->format('oneline');
} else {
    $_billingAddr = $_order->getBillingAddress();
    $_addrLabel = 'Endereço de cobrança';
    $_addrName  = $_billingAddr->getName();
    $_addrLine  = $_billingAddr->format('oneline');
}
// format('oneline') já inclui o nome do destinatário no início — removemos aqui
// porque o nome já é exibido em destaque separadamente logo acima.
if ($_addrName) {
    $_addrLine = preg_replace('/^' . preg_quote($_addrName, '/') . '\s*,?\s*/u', '', $_addrLine, 1);
}
?>
