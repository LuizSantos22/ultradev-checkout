<?php
$_order = $this->getOrder();
if (!$_order || !$_order->getId()):
    return;
endif;

$_incrementId = $_order->getIncrementId();
$_customerName = $_order->getCustomerFirstname();
?>
<div class="ultradev-checkout-success">
    <h1><?php echo $this->__('Pedido recebido com sucesso!') ?></h1>
    <p>
        <?php if ($_customerName): ?>
            <?php echo $this->__('Obrigado pela confiança, %s!', $this->escapeHtml($_customerName)) ?>
        <?php else: ?>
            <?php echo $this->__('Obrigado pela confiança!') ?>
        <?php endif; ?>
    </p>
    <p>
        <?php echo $this->__('Número do pedido:') ?>
        <strong>#<?php echo $this->escapeHtml($_incrementId) ?></strong>
    </p>

    <div class="ultradev-success-payment-info">
        <h3><?php echo $this->__('Informações de pagamento') ?></h3>
        <?php echo $this->getPaymentInfoHtml() ?>
    </div>

    <?php if ($this->getCanViewOrder()): ?>
    <p><a href="<?php echo $this->getViewOrderUrl() ?>"><?php echo $this->__('Ver detalhes do pedido') ?></a></p>
    <?php endif; ?>

    <p><a href="<?php echo Mage::getBaseUrl() ?>"><?php echo $this->__('Continuar comprando') ?></a></p>
</div>
